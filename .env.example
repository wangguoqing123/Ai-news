# Web / Supabase (required for authenticated production mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_SSL=true
SIGNAL_DESK_DEMO_MODE=false
NEXT_PUBLIC_SIGNAL_DESK_DEMO_MODE=false

# Google / YouTube read-only OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/connections/youtube/callback
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# AI provider (OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_MONTHLY_BUDGET_USD=20
AI_INPUT_COST_PER_1M=0
AI_OUTPUT_COST_PER_1M=0

# Transcript provider chain. Example: api,yt_dlp
TRANSCRIPT_PROVIDER=api
TRANSCRIPT_PROVIDER_CHAIN=api,yt_dlp
TRANSCRIPT_API_BASE_URL=
TRANSCRIPT_API_PATH=
TRANSCRIPT_API_KEY=
TRANSCRIPT_API_MAPPING=
TRANSCRIPT_API_TIMEOUT_MS=90000
TRANSCRIPT_FAIL_FAST=false
YT_DLP_PATH=yt-dlp

# Get Notes deployment connector. Local verification can use the existing CLI login.
GET_NOTES_MODE=api
GET_NOTES_BASE_URL=
GET_NOTES_API_TOKEN=
GET_NOTES_KNOWLEDGE_BASE_ID=J9o7AMeY
GET_NOTES_FIELD_MAPPING=
GET_NOTES_WEBHOOK_SECRET=
GET_NOTES_WEBHOOK_WORKSPACE_ID=
GET_NOTES_INITIAL_DAYS=7
GET_NOTES_QPS=1

# Worker / scheduler
WORKER_NAME=signal-worker
WORKER_POLL_MS=2000
WORKER_DB_POOL_SIZE=5
WORKER_LEASE_MS=300000
CRON_SECRET=
CONNECTOR_HOST_ALLOWLIST=
